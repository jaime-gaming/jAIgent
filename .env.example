# jAIgent configuration — copy to .env and fill in.
#   cp .env.example .env
#
# .env is git-ignored. Never commit real keys.
# Prefer `jaigent auth set <provider> <key>` — that writes ~/.jaigent/secrets.env
# (owner-only). `jaigent init` does the same and skips a project .env in
# protected folders (Windows System32). Console links: `jaigent providers`.
# Real environment variables take precedence over anything set here.

# ---------------------------------------------------------------------
# Your API key (required) — jAIgent ships without one.
# ---------------------------------------------------------------------
# OpenAI:    https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Google Gemini:  https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# DeepSeek:       https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=

# Groq:           https://console.groq.com/keys
# GROQ_API_KEY=

# OpenRouter:     https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Together:       https://api.together.xyz/settings/api-keys
# TOGETHER_API_KEY=

# Mistral:        https://console.mistral.ai/api-keys
# MISTRAL_API_KEY=

# Grok (xAI):     https://console.x.ai
# XAI_API_KEY=

# Generic key; overrides both of the above. Handy for OpenAI-compatible gateways.
# JAIGENT_API_KEY=

# ---------------------------------------------------------------------
# Model selection
# ---------------------------------------------------------------------
# openai | anthropic | gemini | openrouter | groq
# deepseek | mistral | xai | together | ollama
#
# ollama runs locally and needs no API key.
# OpenRouter is the usual one-key-many-models option: https://openrouter.ai/keys
# JAIGENT_PROVIDER=openai

# Each provider has its own default. Set "auto" to let jAIgent size the model
# to each task -- see `jaigent route "<prompt>"` to preview the choice.
# The model must support tool calling.
# JAIGENT_MODEL=auto

# Point at any OpenAI-compatible endpoint. Each provider already has a sensible
# default, so you only need this for gateways jAIgent does not know about.
# JAIGENT_BASE_URL=

# ---------------------------------------------------------------------
# Agent behaviour
# ---------------------------------------------------------------------
# Directory the file tools are confined to. Defaults to the current directory.
# JAIGENT_WORKSPACE=

# JAIGENT_MAX_STEPS=12
# JAIGENT_TEMPERATURE=0.2
# JAIGENT_MAX_TOKENS=2048
# JAIGENT_TIMEOUT=60
# JAIGENT_VERBOSE=0

# Stream the answer as it is generated.
# JAIGENT_STREAM=1

# Print a token and cost estimate after each run.
# JAIGENT_SHOW_COST=1

# Override the built-in price table with your own JSON file.
#   {"my-model": {"input": 1.5, "output": 3.0}}   # USD per million tokens
# JAIGENT_PRICES=

# ask | auto | dry-run. Defaults to ask in a terminal, auto when piped.
#   ask      confirm every file change
#   auto     apply without asking
#   dry-run  refuse all changes
# JAIGENT_APPROVAL=

# Snapshot files before mutations (also applies to remote MCP file-write tools).
# JAIGENT_CHECKPOINTS=1

# Where chat sessions are stored.
# JAIGENT_SESSION_DIR=~/.jaigent/sessions

# ---------------------------------------------------------------------
# Skills, settings and schedules
# ---------------------------------------------------------------------
# Base directory for settings.json, skills/ and schedules.json.
# JAIGENT_HOME=~/.jaigent

# Load skills from .jaigent/skills and offer the load_skill tool.
# JAIGENT_SKILLS=1

# Load local tool plugins from .jaigent/plugins.
# JAIGENT_PLUGINS=1

# Hard USD cap for one run. 0 disables it. The spend-cap skill is the soft side.
# JAIGENT_BUDGET=0

# Persist standing notes in .jaigent/memory.md. Off until you turn it on.
# JAIGENT_MEMORY=0

# Collapse older chat turns automatically when history gets long.
# JAIGENT_AUTO_COMPACT=0

# Pick a free model from any provider you have a key for (or a local gateway).
# JAIGENT_MODEL=free

# Override where scheduled tasks are stored.
# JAIGENT_SCHEDULE_FILE=~/.jaigent/schedules.json

# ---------------------------------------------------------------------
# The jAIgent API gateway (`jaigent serve`)
# ---------------------------------------------------------------------
# Where issued jgt- keys are recorded. They are stored hashed, never in plain text.
# JAIGENT_KEYS_FILE=~/.jaigent/keys.json

# ---------------------------------------------------------------------
# Remote ChatGPT Web MCP bridge (optional)
# ---------------------------------------------------------------------
# Public origin only; the server appends /mcp and OAuth metadata paths.
# JAIGENT_PLUGIN_PUBLIC_URL=https://mcp.example.com
# Exact issuer URL of your OAuth/OIDC authorization server.
# JAIGENT_PLUGIN_OAUTH_ISSUER=https://auth.example.com/realms/jaigent
# Usually the same public MCP origin; defaults to JAIGENT_PLUGIN_PUBLIC_URL.
# JAIGENT_PLUGIN_OAUTH_AUDIENCE=https://mcp.example.com
# Workspace the direct MCP tools can access; match JAIGENT_WORKSPACE.
# JAIGENT_PLUGIN_WORKSPACE=/srv/jaigent/workspace
# Existing private gateway URL/key. Create a dedicated key with `jaigent keys new`.
# Never use a provider key here; never commit a real value.
# JAIGENT_PLUGIN_GATEWAY_URL=http://127.0.0.1:8787/v1
# JAIGENT_PLUGIN_GATEWAY_KEY=
# Write tools and session mutation require an explicit opt-in (default off).
# JAIGENT_PLUGIN_ALLOW_WRITE=0

# ---------------------------------------------------------------------
# Web search
# ---------------------------------------------------------------------
# duckduckgo (no key needed) | tavily
# JAIGENT_SEARCH_BACKEND=duckduckgo

# Required only for the tavily backend: https://app.tavily.com
# TAVILY_API_KEY=

# ---------------------------------------------------------------------
# Danger zone
# ---------------------------------------------------------------------
# Set to 1 to let the agent run shell commands in the workspace.
# JAIGENT_ALLOW_SHELL=0

# Expose write_file / edit_file / delete_file from `jaigent mcp`.
# JAIGENT_MCP_WRITE=0
